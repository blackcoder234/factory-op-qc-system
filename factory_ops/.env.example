# FactoryOps QC — Environment Configuration Template (Placeholder)
# Copy this file to .env and configure your secret values.

# Django Security Key (Do NOT commit your real secret key to version control)
SECRET_KEY=replace-with-your-secure-random-secret-key-here

# Debug Mode: set to False in production
DEBUG=False

# Allowed Hosts: comma-separated list of domain names or IP addresses
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Optional: Initial admin password for seed_data command
SEED_ADMIN_PASSWORD=your-secure-seed-admin-password
